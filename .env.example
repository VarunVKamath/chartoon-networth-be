# Zerodha Kite Connect API Credentials
# Get these from https://developers.kite.trade/ after creating an app
# Credentials can either be plain text OR encrypted (prefixed with 'enc:')
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Optional Credential Decryption Key (required if keys are prefixed with 'enc:')
ENCRYPTION_KEY=your_decryption_password
# ENCRYPTION_SALT=optional_custom_salt_value

# IMPORTANT: Paper Trading is DEFAULT and SAFE.
# Set to 'true' ONLY if you want to place REAL orders with real money.
# Misuse can lead to financial loss. Use at your own risk.
REAL_TRADING=false

# Risk Management Parameters
STOP_LOSS_PERCENT=0.75
TARGET_PERCENT=1.5

# Minimum score (out of 100) required to trigger a BUY
SCORE_THRESHOLD=65

# Server Port
PORT=5000

# Timezone for scheduler (IST for Indian market)
TZ=Asia/Kolkata
